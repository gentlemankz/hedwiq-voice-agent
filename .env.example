# LiveKit Configuration
# Copy your LiveKit credentials here
LIVEKIT_URL=your_livekit_url
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Deepgram API Key for Speech-to-Text
# Get your API key from https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key

# Azure OpenAI Configuration for Insight Extraction
# Get your credentials from Azure Portal: https://portal.azure.com
# These env var names are auto-detected by the LiveKit OpenAI plugin
AZURE_OPENAI_API_KEY=your_azure_openai_api_key
AZURE_OPENAI_ENDPOINT=your_azure_openai_endpoint
OPENAI_API_VERSION=2024-10-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# Document Service Configuration (for Phase 1+ Document Reference feature)
AGENT_SERVICE_URL=http://localhost:8000
INTERNAL_SERVICE_TOKEN=your_internal_service_token

# Supabase Configuration (for downloading documents from Supabase Storage)
# These are required for the /documents/process endpoint to work
SUPABASE_URL=https://vztgefhkhqemmmbrbbas.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supbase_anone_key

# PostgreSQL Database Configuration (for Agenda Tracking - Phase 4)
# This must match the DATABASE_URL in frontend/.env.local
DATABASE_URL=your_database_url